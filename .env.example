# Copy to .env and set the two secrets before starting.
ADMIN_ACCESS_KEY=
KEY_SECRET=
PUBLIC_KEY_HOURS=24
DISCORD_URL=https://discord.gg/fDwPCmpkkh
YOUTUBE_CHANNEL_URL=
YOUTUBE_VIDEO_URL=
# Optional per-step overrides; empty uses YOUTUBE_VIDEO_URL.
COMMENT_VIDEO_URL=
LIKE_VIDEO_URL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Cloudflare D1 is accessed through the Worker binding named DB.
# Set this ID in Cloudflare Build Variables for the target account.
CF_D1_DATABASE_ID=
KEY_MAINTENANCE=0
REQUIRE_TURNSTILE=1
DISCORD_LOGIN_REQUIRED=1
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord numeric user IDs, separated by commas. No IDs means no admin access.
DISCORD_ADMIN_USER_IDS=
